# Port d'écoute de l'API
PORT=3000

# URL du front autorisée par CORS (en dev, Vite tourne sur 5173)
CLIENT_URL=http://localhost:5173

# Supabase : Project URL (https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase : clé SECRÈTE (sb_secret_...) ou, à défaut, la clé legacy "service_role".
# ⚠️ Clé serveur uniquement : ne jamais la mettre dans le front ni la commiter.
SUPABASE_SECRET_KEY=
